# Normalize text files and end-of-line handling
* text=auto

# Enforce LF for source files (Git will convert on commit)
*.php  text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Treat images and other binaries as binary (no EOL conversion)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.jfif binary
*.ico  binary
*.pdf  binary
*.zip  binary
